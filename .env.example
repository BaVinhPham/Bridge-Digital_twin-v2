# Copy to .env only when the Azure SQL database is available.
# Use a logical-server hostname, without https:// or a port.
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=bridge-digital-twin-v2
AZURE_SQL_USER=bridge_app
# Single quotes preserve literal $ and # characters in Docker Compose .env files.
AZURE_SQL_PASSWORD='replace-with-your-password'
# Separate from the original project's localhost:8000.
API_PORT=8001
